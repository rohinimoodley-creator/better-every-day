{
  "appId": "com.bettereveryday.app",
  "appName": "Better Every Day",
  "webDir": "dist",
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1800,
      "launchAutoHide": true,
      "backgroundColor": "#1e3d30",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#1e3d30"
    },
    "Keyboard": {
      "resize": "body"
    }
  }
}
